  m_Script: {fileID: 11500000, guid: 5a6e1b9eb5d1a7748bf6d12595f68d2a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnknownGame.GameFlow::IntroManager
  pantalla: {fileID: 289842192}
  pantallaVideo: {fileID: 1777540544}
  reproductorVideo: {fileID: 586211864}
  fade: {fileID: 1448992938}
  subtitulo: {fileID: 1756913003}
  fondoSubtitulo: {fileID: 397989560}
  margenFondo: {x: 40, y: 20}
  voz: {fileID: 0}
  musica: {fileID: 1362573045}
  escenas:
  - imagen: {fileID: 21300000, guid: 98846f1acda887b4c9d4ccdfb33880db, type: 3}
    video: {fileID: 0}
    texto: "Esa noche estaba por casualidad en un mercado, y llegu\xE9 a un puesto de cosas viejas."
    narracion: {fileID: 0}
    duracion: 6
  - imagen: {fileID: 21300000, guid: 9f73cb4ff6494aa458c08ce4699f469c, type: 3}
    video: {fileID: 0}
    texto: "Entre todo eso, un CD sin car\xE1tula llam\xF3 mi atenci\xF3n."
    narracion: {fileID: 0}
    duracion: 6
  - imagen: {fileID: 21300000, guid: 1f9068c18c449eb4f8bc1fe63923b99d, type: 3}
    video: {fileID: 0}
    texto: "Dec\xEDa: \xABDemo. No apto para novatos\xBB.  Y claro, eso fue justo lo que me convenci\xF3."
    narracion: {fileID: 0}
    duracion: 6
  - imagen: {fileID: 21300000, guid: 3e24e0443a9c8e746ada8144d16ed2de, type: 3}
    video: {fileID: 0}
    texto: "Llegu\xE9 a casa, encend\xED la computadora y puse el CD. Solo quer\xEDa ver qu\xE9 tan malo pod\xEDa ser."
    narracion: {fileID: 0}
    duracion: 6
  - imagen: {fileID: 0}
    video: {fileID: 32900000, guid: a78106e4e2148c54fa3351a0e373378a, type: 3}
    texto: "Pero la pantalla empez\xF3 a parpadear y algo me jal\xF3 hacia adentro..."
    narracion: {fileID: 0}
    duracion: 5
  materialSubtitulo: {fileID: 2100000, guid: dd1d98ebe5dcf8847937334c23955cb2, type: 2}
  siguienteEscena: Menu-Principal
  duracionFade: 1
  pausaNegro: 0.15
  velocidadTexto: 0.06
  volumenMusica: 1
  duracionFadeMusica: 0.6
  fadeFinalVideo: 2
  colorFlash: {r: 0, g: 0, b: 0, a: 1}
  duracionFlash: 1
  pausaFlash: 1.5
  efectos: {fileID: 1361053069}
  sonidoClick: {fileID: 8300000, guid: 4f3e6228ca228684e9423fb19ab61f26, type: 3}
