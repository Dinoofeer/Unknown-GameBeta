      propertyPath: sequence.Array.size
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4311196081767224594, guid: 86a6aa60c0a87104896f2913bcb3ccee, type: 3}
      propertyPath: sequence.Array.data[0].text
      value: "Vaya, qu\xE9 sorpresa. Una puerta cerrada."
      objectReference: {fileID: 0}
    - target: {fileID: 4311196081767224594, guid: 86a6aa60c0a87104896f2913bcb3ccee, type: 3}
      propertyPath: sequence.Array.data[1].text
      value: "\xBFHas probado abrirla con... no s\xE9, una llave?"
      objectReference: {fileID: 0}
    - target: {fileID: 4311196081767224594, guid: 86a6aa60c0a87104896f2913bcb3ccee, type: 3}
      propertyPath: sequence.Array.data[3].text
      value: Tranquilo, tampoco esperaba que lo supieras.
      objectReference: {fileID: 0}
    - target: {fileID: 4311196081767224594, guid: 86a6aa60c0a87104896f2913bcb3ccee, type: 3}
      propertyPath: sequence.Array.data[0].seconds
