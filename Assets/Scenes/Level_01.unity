      propertyPath: m_Name
      value: T_Puerta
      objectReference: {fileID: 0}
    - target: {fileID: 4311196081767224594, guid: 86a6aa60c0a87104896f2913bcb3ccee, type: 3}
      propertyPath: line
      value: "La puerta solo se abre con su llave. \xBFLa traes... o la dejaste por ah\xED?"
      objectReference: {fileID: 0}
    - target: {fileID: 4311196081767224594, guid: 86a6aa60c0a87104896f2913bcb3ccee, type: 3}
      propertyPath: repeat
      value: 1
      objectReference: {fileID: 0}
