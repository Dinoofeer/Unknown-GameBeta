<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="MenuStyle.uss" />
    <ui:VisualElement name="menuRoot" class="menu-root">
        <ui:VisualElement name="background" class="menu-background" picking-mode="Ignore">
            <ui:Image name="backgroundFallback" class="menu-background-image" picking-mode="Ignore" />
            <ui:Image name="backgroundVideo" class="menu-background-image is-hidden" picking-mode="Ignore" />
            <ui:VisualElement class="menu-background-shade" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="menuButtons" class="menu-buttons">
            <ui:Button name="newGameButton" text="JUGAR" class="menu-button menu-button--selected">
                <ui:VisualElement class="menu-pointer" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="continueGameButton" text="CONTINUAR PARTIDA" class="menu-button is-hidden">
                <ui:VisualElement class="menu-pointer" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="settingsButton" text="CONFIGURACIÓN" class="menu-button">
                <ui:VisualElement class="menu-pointer" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="quitButton" text="SALIR DEL JUEGO" class="menu-button">
                <ui:VisualElement class="menu-pointer" picking-mode="Ignore" />
            </ui:Button>
            <ui:Label name="menuStatus" class="menu-status is-hidden" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="replaceConfirmation" class="confirmation-overlay is-hidden">
            <ui:VisualElement class="confirmation-panel">
                <ui:Label text="¿CREAR OTRA PARTIDA?" class="confirmation-title" />
                <ui:Label text="Se reemplazará tu partida anterior y perderás su progreso. ¿Quieres empezar de nuevo?" class="confirmation-message" />
                <ui:VisualElement class="confirmation-actions">
                    <ui:Button name="cancelNewGameButton" text="CANCELAR" class="dialog-button dialog-button--cancel" />
                    <ui:Button name="confirmNewGameButton" text="CREAR PARTIDA" class="dialog-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="settingsPanel" class="confirmation-overlay is-hidden">
            <ui:VisualElement class="confirmation-panel settings-panel">
                <ui:Label text="CONFIGURACIÓN" class="confirmation-title" />
                <ui:Label text="AUDIO" class="settings-section" />
                <ui:Slider name="masterVolume" label="VOLUMEN GENERAL" low-value="0" high-value="1" value="1" class="settings-slider" />
                <ui:Slider name="musicVolume" label="MÚSICA" low-value="0" high-value="1" value="1" class="settings-slider" />
                <ui:Slider name="sfxVolume" label="EFECTOS" low-value="0" high-value="1" value="1" class="settings-slider" />
                <ui:Label text="VIDEO" class="settings-section" />
                <ui:Toggle name="fullScreenToggle" label="PANTALLA COMPLETA" value="true" class="settings-toggle" />
                <ui:VisualElement class="confirmation-actions">
                    <ui:Button name="closeSettingsButton" text="VOLVER" class="dialog-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
