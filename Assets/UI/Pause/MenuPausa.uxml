<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/MenuStyle.uss" />
    <ui:Style src="PauseStyle.uss" />
    <ui:VisualElement name="pauseRoot" class="menu-root pause-root is-hidden">
        <ui:VisualElement name="pauseContent" class="pause-content">
            <ui:Label text="PAUSA" class="pause-title" picking-mode="Ignore" />
            <ui:Label text="Enserio necesitas un respiro? Apenas vamos empezando" class="pause-taunt" picking-mode="Ignore" />
            <ui:Button name="resumeButton" text="REANUDAR" class="menu-button">
                <ui:VisualElement class="menu-pointer" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="restartButton" text="REINICIAR" class="menu-button">
                <ui:VisualElement class="menu-pointer" picking-mode="Ignore" />
            </ui:Button>
            <ui:Button name="exitButton" text="SALIR" class="menu-button">
                <ui:VisualElement class="menu-pointer" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="exitConfirmation" class="confirmation-overlay is-hidden">
            <ui:VisualElement class="confirmation-panel pause-exit-panel">
                <ui:Label text="JAJAJA sabia que no ibas a poder escapar, Mediocre" class="confirmation-title pause-exit-message" />
                <ui:Label name="exitStatus" class="confirmation-message pause-exit-message is-hidden" />
                <ui:VisualElement class="confirmation-actions">
                    <ui:Button name="cancelExitButton" text="CANCELAR" class="dialog-button dialog-button--cancel" />
                    <ui:Button name="confirmExitButton" text="SALIR" class="dialog-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
